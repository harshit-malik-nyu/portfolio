{
  "scope": "Synthetic SQLite semantic-model demonstration, not a deployed warehouse or scale benchmark. Day dimension includes observed days only; missing days are not zero activity.",
  "checks": [
    "event-key uniqueness",
    "visitor referential integrity",
    "daily mart reconciliation after each delivery"
  ],
  "query_plan_note": "Normalized COVERING INDEX to INDEX for SQLite-version portability; not a covering-index or speedup claim.",
  "query_plan": [
    "SEARCH events USING INDEX ix_events_day_type (<expr>=? AND event=?)"
  ],
  "scenarios": [
    {
      "scenario": "Baseline published",
      "status": "PUBLISHED",
      "report_version": 1,
      "reconciled": true,
      "daily": [
        {
          "day": "2026-01-01",
          "events": 4,
          "visitors": 2,
          "buyers": 1,
          "orders": 1
        }
      ]
    },
    {
      "scenario": "Replay is harmless",
